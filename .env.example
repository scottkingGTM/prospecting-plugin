# Prospecting Plugin backend — copy to .env and fill in. Never commit .env.

# Postgres connection string for the least-privilege `prospector_service`
# role (create it with sql/02_create_role.sql, then set its password out of
# band — see that file's header). On Supabase, use the SESSION POOLER host
# (the direct host is IPv6-only); the pooler username is role.project-ref.
PROSPECTOR_DATABASE_URL=postgresql://prospector_service.YOUR-PROJECT-REF:CHANGE_ME@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# HubSpot private-app token. Scope it to exactly: contacts read/write,
# companies read/write, deals read-only. Nothing else.
HUBSPOT_TOKEN=pat-REPLACE
# HubSpot portal id, for app.hubspot.com record links in the panel
# (optional; links are omitted when this is empty).
HUBSPOT_PORTAL_ID=

# Enrichment vendor API key. FullEnrich is the bundled reference adapter;
# to use a different vendor, add its adapter + key (see PROVIDERS.md).
FULLENRICH_API_KEY=REPLACE

# Chrome extension origin(s) allowed by CORS — comma-separated. An unpacked
# extension gets a different id per machine, so during local dev set this to
# YOUR install's id (chrome://extensions shows it). A published extension has
# a stable id you can pin once.
# e.g. EXTENSION_ORIGIN=chrome-extension://aaaa...,chrome-extension://bbbb...
EXTENSION_ORIGIN=chrome-extension://REPLACE

# Safety: env-pinned. A request body can NEVER turn dry-run off; only this
# variable can. Leave it true until you have verified an end-to-end dry run.
DRY_RUN=true

HOST=127.0.0.1
PORT=8080

# Optional Slack webhook for alerts (cap breaches, provider errors).
SLACK_WEBHOOK_URL=
